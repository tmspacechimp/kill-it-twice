# Shared verification defaults, independent of the demo.
DEFAULT_SEED_SHIPMENTS=4000
DEFAULT_WAIT_TIMEOUT_MS=600000

# The harness resolves these references; a literal value overrides the default.
G1_SEED_SHIPMENTS=${DEFAULT_SEED_SHIPMENTS}
G1_WAIT_TIMEOUT_MS=${DEFAULT_WAIT_TIMEOUT_MS}
G1_INCREMENTAL_EVENTS=500
G1_CRASH_EVENT_ID=2048

G2_SEED_SHIPMENTS=${DEFAULT_SEED_SHIPMENTS}
G2_WAIT_TIMEOUT_MS=${DEFAULT_WAIT_TIMEOUT_MS}
G2_INCREMENTAL_EVENTS=6000
# Two initial crashes followed by one incremental crash (10,000 + 2,048).
G2_CRASH_EVENT_IDS=[2048,2048,12048]
