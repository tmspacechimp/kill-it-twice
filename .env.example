# Copy to .env and set both passwords before starting Compose.
# Use local-only passwords; .env is ignored by Git.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=

# Demo: initial shipments, later event rows, events/second, and log bytes.
DEMO_SEED_SHIPMENTS=4000
DEMO_INCREMENTAL_EVENTS=500
DEMO_INCREMENTAL_RATE=20
DEMO_WAIT_TIMEOUT_MS=600000
DEMO_LOG_MAX_BYTES=10485760

# Optional host port overrides if the defaults are already in use.
POSTGRES_PORT=5432
OPENSEARCH_PORT=9200
DASHBOARDS_PORT=5601
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Delay after an empty or partial incremental batch, in milliseconds.
POLL_INTERVAL_MS=1000
# After the first incremental rows arrive, stop after this many consecutive empty reads.
POLL_MAX_EMPTY=3

# Shared health check settings for all infrastructure services.
DEFAULT_HEALTHCHECK_INTERVAL=10s
DEFAULT_HEALTHCHECK_TIMEOUT=10s
DEFAULT_HEALTHCHECK_RETRIES=12
DEFAULT_HEALTHCHECK_START_PERIOD=30s
